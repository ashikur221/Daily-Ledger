# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/daily-ledger?retryWrites=true&w=majority

# JWT secrets — use long random strings (openssl rand -base64 64)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Token expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server port
PORT=5000

# Client origin for CORS (your Netlify URL in production)
CLIENT_ORIGIN=http://localhost:5173

# App admin email (first user, auto-granted admin role)
ADMIN_EMAIL=your@email.com

# Node environment
NODE_ENV=development
